# Database connection string for PostgreSQL in production.
# Use the Supabase Direct connection string, not the local SQLite file.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require"

# JWT secret used to sign API tokens.
JWT_SECRET="your-super-secret-jwt-key"

# Public app URL where the frontend is served.
APP_URL="https://your-app.onrender.com"

# Optional: local development port.
PORT="3000"
